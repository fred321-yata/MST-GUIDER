{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start School Guider",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE.*",
          "endsPattern": "Local:"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
